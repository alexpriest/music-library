{
  "name": "music-library-mcp",
  "version": "1.0.0",
  "description": "MCP server for searching Alex's physical sheet-music library by mood, vibe, genre, composer, and more.",
  "type": "module",
  "bin": {
    "music-library-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/http.js",
    "start:stdio": "node dist/index.js",
    "dev": "node --experimental-strip-types --watch src/http.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.1",
    "express": "^4.21.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
